# GEMINI_API_KEY: Optional AI Studio runtime variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL injected at runtime
APP_URL="http://localhost:3000"

# JWT_SECRET: Signing secret for authentication tokens (in-memory fallback used if unset)
JWT_SECRET=

# PORT: Server port (must remain 3000 in AI Studio preview)
PORT=3000

# DB_PATH: Optional path to SQLite database file
DB_PATH=./data/tingloy.db
